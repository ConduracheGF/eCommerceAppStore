    </Compile>
    <Compile Update="OrdersControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ProductForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ProductsControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ReportsControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="SettingsControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
</Project>